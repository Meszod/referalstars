BOT_TOKEN=put_your_botfather_token_here
BOT_USERNAME=your_bot_username

# Docker compose uchun host nomlari: db, redis.
# Lokal ishga tushirsangiz: localhost ishlating.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/referral_bot

REDIS_URL=redis://redis:6379/0

# Vergul bilan ajratilgan Telegram ID'lar: 111111111,222222222
ADMIN_IDS=111111111

REFERRAL_REWARD=5
MIN_WITHDRAWAL=50

# Qo'shimcha (ixtiyoriy)
TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO
LOG_DIR=logs
